{
  "name": "cursor-chess",
  "displayName": "Cursor Chess",
  "description": "Solve bite-sized tactical chess puzzles in your sidebar while your agents work.",
  "version": "0.5.0",
  "publisher": "gogojo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/GOGOJO/Cursor-Chess"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "chess",
    "puzzles",
    "tactics",
    "lichess",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorChess",
          "title": "Cursor Chess",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cursorChess": [
        {
          "type": "webview",
          "id": "cursorChess.puzzleView",
          "name": "Puzzle",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorChess.open",
        "title": "Open",
        "category": "Cursor Chess"
      },
      {
        "command": "cursorChess.newPuzzle",
        "title": "New Puzzle",
        "category": "Cursor Chess",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "cursorChess.importPuzzles",
        "title": "Import Lichess Puzzles…",
        "category": "Cursor Chess",
        "icon": "$(cloud-download)"
      },
      {
        "command": "cursorChess.clearImportedPuzzles",
        "title": "Remove Imported Puzzles…",
        "category": "Cursor Chess"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorChess.newPuzzle",
          "when": "view == cursorChess.puzzleView",
          "group": "navigation"
        },
        {
          "command": "cursorChess.importPuzzles",
          "when": "view == cursorChess.puzzleView",
          "group": "1_library@1"
        },
        {
          "command": "cursorChess.clearImportedPuzzles",
          "when": "view == cursorChess.puzzleView",
          "group": "1_library@2"
        }
      ]
    }
  },
  "scripts": {
    "build:extension": "esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --sourcemap",
    "build:webview": "vite build",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "npm run build:extension -- --watch",
    "watch:webview": "vite build --watch",
    "dev:webview": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run check && vsce package --no-dependencies --skip-license",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-chessboard": "5.12.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
